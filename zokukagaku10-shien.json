   "text": "つみはやも昨日の春の木のめおもにほひましさる霜の初花童總角い牛のあゆみおまかせつゝくれゆく道も急がざりけり高牧野たかの山さかき御影も匂ふらむ槇の葉おしのありありの月衣手森くをていにし秋や形見ふとヾめ々む紅葉おさね比衣手比杜祝言言の葉比さきはふみ代ふ逢ふけり花のみならぞ實さへ結びて風破旅夢ふる里へ通ふ夢路比關守いふきたつ夜半のあらしなりけり二月の末つ方ある人の越の國へ下りけるにかはりて君いさぞ都の花を成しむらむ我いあしぢの雪をこそおもへ安政三辰十月九日紀氏九百回御忌ふ寄郭公懷舊あふぎても誰きかざらむ杜宇をちかへりなく千代のふる聲香川景樹十三回忌に三月盡といふををしむらむ世の人並比春ならで今日〓淚ふくれおけるかな箭園和歌集抄終",
   "poems": [
    "145",
    "146",
    "147",
    "148",
    "149",
    "150",
    "151",
    "152",
    "153"
   ],
   "lb": []
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "今日といヘバ遠き昔をひくゑめお神代の春やたち歸るらむ",
   "kana": "",
   "speaker": "",
   "page": 211,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "いでたゝきミ袖ゆさのお吹おけり竹のうでなの春のはつ風",
   "kana": "",
   "speaker": "",
   "page": 211,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "何よりもまづ改まる世の人比こゝろや春比あゝろなるらむ",
   "kana": "",
   "speaker": "",
   "page": 211,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "梅かをる入江北岸比やなぎ原こぎめぐりてもあかぬ春かな",
   "kana": "",
   "speaker": "",
   "page": 211,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "靑柳のえだといなしに篠をざれなびけバ見ゆる春のはつ風",
   "kana": "",
   "speaker": "",
   "page": 211,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "春比來て早も六日おなりおけりいざ少女らお若菜つませむ",
   "kana": "",
   "speaker": "",
   "page": 211,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "たえ〓〓にさヾよふ池の薄氷とけぬながらお春やゑるらむ",
   "kana": "",
   "speaker": "",
   "page": 211,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "うちなびく霞の奧ふつゝみけり寢ての朝け比くろ髪のやま",
   "kana": "",
   "speaker": "",
   "page": 211,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "生駒嶺比霞める奧ふ比こりけりたヾ面かげのかつらき比山",
   "kana": "",
   "speaker": "",
   "page": 211,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "春霞なびくばかりおなりおけりあとかは柳かへり見すれが",
   "kana": "",
   "speaker": "",
   "page": 211,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "わが心ひかるゝものハ靑柳のいとかの山比かもミなりけり",
   "kana": "",
   "speaker": "",
   "page": 211,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "打なびく柳比いとおよりてこそまづくる春の色い見にけれ",
   "kana": "",
   "speaker": "",
   "page": 212,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "てにとらバけぬべき露の白玉我柳比いとあされろぬきりむ",
   "kana": "",
   "speaker": "",
   "page": 212,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "春風いふくとしもなく吹おけりなびくともなくなびく柳あ",
   "kana": "",
   "speaker": "",
   "page": 212,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "もゝちどりさへづりかはも曙お獨まぎれぬうぐひす北こゑ",
   "kana": "",
   "speaker": "",
   "page": 212,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "我やどもとなりも竹Hそのふあて行きてい來なく鶯のあゑ",
   "kana": "",
   "speaker": "",
   "page": 212,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "あさな〓〓朝いおくれてくを竹のふしながらきく鶯北こゑ",
   "kana": "",
   "speaker": "",
   "page": 212,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "春比日をひとりのみ鳴く鶯〓こゑきくわれも友なしおして",
   "kana": "",
   "speaker": "",
   "page": 212,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "靑柳のかげふむ道いくらけれど明ぬと出るうぐひすのこゑ",
   "kana": "",
   "speaker": "",
   "page": 212,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "比どかおもなき木傳へる鶯比あゑおそむけてちるさくら哉",
   "kana": "",
   "speaker": "",
   "page": 212,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "櫻ばなちる木のもとに鶯比あやなくわれをさそひ來ふけり",
   "kana": "",
   "speaker": "",
   "page": 212,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "かをむらむ雲井い玄らぞ鶯Hはつねぞ春北玄るしなりける",
   "kana": "",
   "speaker": "",
   "page": 212,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "うれしくも梅い根づきてさきおけり木傳ひそめむ鶯もグな",
   "kana": "",
   "speaker": "",
   "page": 212,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "日枝のねの雪ハ霞ふきえはてゝ梅こそにほへ白かはのさと",
   "kana": "",
   "speaker": "",
   "page": 212,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "きヾもなくをち比大野み今日も來て遊ぶ糸ふもなるゝ春哉",
   "kana": "",
   "speaker": "",
   "page": 212,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "靑柳比枝ふく風もなきものをいかおみざるゝ野邊の糸ゆふ",
   "kana": "",
   "speaker": "",
   "page": 212,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "さめふける此世の夢代手枕をむもびはてつと何おもひけむ",
   "kana": "",
   "speaker": "",
   "page": 212,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "山比はをたち離れたるかひもなし霞をいでぬ春のよ此つき",
   "kana": "",
   "speaker": "",
   "page": 212,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "天の原たなびく雲いなけれどもかもかおなりぬ春の夜比月",
   "kana": "",
   "speaker": "",
   "page": 212,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "をし鴨い歸りはてたる巨掠代入江おうかぶはる比夜のつき",
   "kana": "",
   "speaker": "",
   "page": 212,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "玄せぶおも遠きむかしの影なれバよそおぞ霞む春のよせ月",
   "kana": "",
   "speaker": "",
   "page": 212,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "ひむがしの山比下いほ春をへてもむとしもなき十六夜の月",
   "kana": "",
   "speaker": "",
   "page": 212,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "まづ開く花比あよみを栞ふておもかげ匂ふやまざくらかな",
   "kana": "",
   "speaker": "",
   "page": 212,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "ふく風も平のみや比さくら花さきちるほどぞ久しかりける",
   "kana": "",
   "speaker": "",
   "page": 212,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "ちりはてむまでい歸らじ櫻花わがふるさとn七世へぬとも",
   "kana": "",
   "speaker": "",
   "page": 212,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "敷島のやまと島、根にたつと見ておとせぬ浪いさくらんけり",
   "kana": "",
   "speaker": "",
   "page": 212,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "やど近くうゑてみれども櫻ばなあかぬ心いかはらざまろうと",
   "kana": "",
   "speaker": "",
   "page": 212,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "昨日けふ西に東おみやこ人ちるこそはなのさかりなりけれ",
   "kana": "",
   "speaker": "",
   "page": 212,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "うちむれてたゆたふ見れバ大炊川花こそ人のゐせぎんりき",
   "kana": "",
   "speaker": "",
   "page": 212,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "玉鉾比道のゆくへいがはれども花ゆゑならぬ人なかりけり",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "さきもあへぞかつちる見れバ中々ふ待つ間ぞ花の盛んりる",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "おもかげお比あるばかりを山櫻おにあくがるゝ心なるらむ",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "さきしより野山北花ふそめうへも心の色をたれふ見せまし",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "いざさらバふく春風おちる花の輕くも世をバ思ひなしてむ",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "さけバさきちれバちりゆく世比人H心やはなの姿なるらむ",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "かはづなく〓瀧川の岩こえてをらむいかさきやまぶき比花",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "なさな〓〓露ふ玄をるゝ山吹もいはぬ思比あれバなりけり",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "かゝれこそ賴まざりつれ春くれバ雲のよそふも歸る雁かな",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "かりグねい雲井のよそに歸るをり花比盛をたれお見せまし",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "うち霞む空に消えゆく雁がねいまく玉づさの心地こそすれ",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "玄〓簾ふきまく春比朝風をつばさおがけて飛ぶつぱめかな",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "いかおせむなきとめつべき鶯のこゑもかぎりの春比ゆふ暮",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "靜けさをいつおたとへむ鶯比なくねぼかりの春のあけぼの",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "淺茅生の小野の芝生比つが菫つみくらしてもあかぬ色かな",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "蛙なく聲ばかりしてあしひき比山田の春いさびしかりけり",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "はなぞめの衣手寒しをやま田比苗代ときになりふけるかな",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "今日よりハ大宮人も山がつもひとへおかろき夏ごろもかな",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "時鳥いづれをかげと思ふらむならびの池のふぢなみ比はな",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "みよし野の靑根が峯おたちいでてみゆる若葉や櫻なるらむ",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "なか〓〓に物靜なるさが山のさくらの若葉はなおまさきり",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "玉藻かるなごの浦風ふきおけりいさりがてらに夕凉ミせむ",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "夏草のつゆ見るよりも涼しきいあけたるそらの綠なりけり",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "おしなべて若葉隱れお成ふけり常磐の里やいづれなるらむ",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "若葉さすかげの〓見えて山城のつヾきの里お夏いきおけり",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "白露のたまの塵のみさまりけり何のはらはむとあなつの花",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "なよ竹のよいふしよげふ更たれどいやねグてゐも澄る月哉",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "夏の日をいとひ暮せし山里を月とともふやいでてかへらむ",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "やまびおの聲もおよばぬ大ぞら比よそおてもなく時鳥かな",
   "kana": "",
   "speaker": "",
   "page": 213,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "こむといひし人いおくれてまちがてお匂ひし峯の月ハ昇りぬ",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "盃あさすかど見れバ照る月もこよひの友の數おやいあらぬ",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "すみわさる空の通路とほけれパ松おやすらふ月のかげあな",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "大空のひのりおまさる心地してさやまぶ池ふすめる月かな",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "武藏鎧はるかおかけてひく駒の月毛もにほふ雲のうへのな",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "少女らがつまとる小野の夕ま暮おくらむ露をよそふ玄る哉",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "八千種の花さく野邊をふく風ゐわがおもひ草うごく秋かな",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "このゆふべ荻の葉さやぐ村雨ふはじめて秋のこゑをきく哉",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "されバこそ思ひあはせのから衣みにしみそむる秋の夕かぜ",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "鹿のねおきゝ傳へても悲しきい端山がくきの秋のゆふぐれ",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "あよひしも初聲すなり彥ほしの戀ふや鹿もならひそめけむ",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "棚機いあまの廣野の月くさにころもいろどり君まつらしも",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "おとは山あさゐる峰の玄ら雲をたち出てなくほとゝぎす哉",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "ふるさとの花橘の香をとめてやまほとゝぎも今やなくらむ",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "なつ衣ひとへふ寒しあけぶされ夢路ふかよふあき北はつ風",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "祗園の神の旅ねふなりおけりたえぞふきこせ加茂の川かぜ",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "夏くさの露ばかりこそそゝぎりれけしきのみなる夕立の雨",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "なる神H音羽のさとにふりくなりをちかさなりし夕立比雨",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "ともしする宮城お原ふたつ鹿ハ木の玄たつゆの命なりけり",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "ちはやふる神と君ふやなびくらむおふる葵北ふさ葉なる哉",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "あふひ草心ふかけしがみ山のみあれの今日ふ成にけるかな",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "玉ざれの浅もの綠をなつ艸せいろおよそへて飛ぶほさる哉",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "瀨をとめて螢とびかふかげなくバ音のみきかむ草川のみづ",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "なきかはす蟬み淚やあまるらむ露こそおつきころもでの森",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "こむといひし言比葉さへや朽ぬらむとはで久しき梅雨北雨",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "わが園の靑葉がくれの梅なれやうみこそわされ梅雨比あめ",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "時鳥はるかふ名北る一あゑいあゝろ空なるどれのみぞきく",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "まちし夜のかぞかきならも琴のねお恐びかねてやなく時鳥",
   "kana": "",
   "speaker": "",
   "page": 214,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "雪の上をふまで通はむ道もグなふらがといひし人もこそくれ",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "ふる雪のをやみまつ間比たゆたひお訪んと思ひし君ぶきませる",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "葛城や高間の山のよそふのミつれなくふれるけさの初ゆき",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "冬比池お浮きてなきゆく鳰鳥い波比いづこの友玄さふらむ",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "ぬば玉の暗のよど野比澤水ふかげこそ見えね鴨ぞはねきる",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "あけぬとて漕ぎ別れゆく朝妻の舟よびかはし千鳥なくなり",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "久方の月の桂比かげさかみいたづらにふく木がらしのかぜ",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "高比川氷るばかりおてる月のさゆる夜よしと千鳥玄ば鳴く",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "木枯の風のやどりと成ふけり松の〓たてるなグをかのさと",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "かみな月時雨の雨ふぬれしよりうつろひそめし白菊のはな",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "ふな人の袖も玄とヾに最上川みなか〓のけでふる時雨かな",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "大ひえや小日枝はれゆく浮雲のくらまの山ぞ打〓ぐもたる",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "時雨おいぬるゝもをしく成ふけりからくれなゐの衣手の杜",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "、野山みなめぐりはてけむ九重比道のちまさふふる時雨のな",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "置きあまる草葉の露もあるものをあくれびきゆる虫の聲々",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "我宿のくさいみながら拂はせじよな〓〓虫の聲あはれなり",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "こほろぎの聲のひゞきに亂れけり玉くしげ野の秋の玄ら露",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "114",
   "text": "さゞなみの志賀の大わさ霧こめておぼつかなみふ雁鳴渡る",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "115",
   "text": "狩おこし人い歸りて秋の野のうづら玄ばなく妻こふらしも",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "116",
   "text": "すまの蜑のゑほやき衣うちかへし浪のよるさへ暇なきかな",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "117",
   "text": "秋風にくも比まよひも消えはてゝあみどお峰をいづる月影",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "118",
   "text": "露をおきて霜ゐ思ひやかけつらむつれなく見ゆる薄紅葉哉",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "119",
   "text": "今日をおきて露も何せん降る兩にぬれてをにほへ白菊の花",
   "kana": "",
   "speaker": "",
   "page": 215,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "120",
   "text": "かきくらしふるといをれど暮るゝ夜ふ隱れむ雪比惜くもある哉",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "121",
   "text": "み狩人ゑばし体らへふる雪比はれぬかさ野ハ嗚く鳥もなし",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "122",
   "text": "寒しとてひさもらおやい厭ふべき嵐ぞ冬北ゑるべなまるる",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "123",
   "text": "くみ捨し板井の水をお比朝け結ぶこほりいこゝるありけり",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "124",
   "text": "くちなしの色お通ひて菊の花冬ともいはぞおほひけるかな",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "125",
   "text": "ちり埋む木葉お人やとはぬとておけ路をはらふ嵐なるらむ",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "126",
   "text": "よの中お思ひきえてもふる物をやもくも雪比つもりける哉",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "127",
   "text": "うちわさも竹田の原も埋もれて雪あまぢかき深くさのやま",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "128",
   "text": "高島〓かち野比原あふる雪比はれ間も旅いまされざりけり",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "129",
   "text": "言とへバ言とひかへも唐鳥のかなしといはゞ戀しといはなむ",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "130",
   "text": "君ならぬ人どふとはぞおりふけり蓬ら庭とあれはてしより",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "131",
   "text": "大きみの新宮うつりほど近〓みち〓めむとはつゆきぞふる",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "132",
   "text": "さき草のみつとかぞふる神山の一つや富士の高ねなるらむ",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "133",
   "text": "柴の戶をみねの嵐いたゝけども明てまつべき人なかりけり",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "134",
   "text": "昔おもふ心のだねやこぼれけむ軒お玄のぶの草おひおりで",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "135",
   "text": "千代かけて色も心もかはらねバあけくき竹ぞ君がともなる",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "136",
   "text": "わが窓のいさゝむら竹てる月北影おさはるも嬉しかりけり",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "137",
   "text": "はふ蟹の横走りてもゆく道をふむとやいはむあはれよの中",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "138",
   "text": "心あもあらぬ事はみ見ゆる哉げふ夢ばかりはかなきいなし",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "139",
   "text": "いつのまお蚊遣たくまでなりぬらんむろうる賤ぶ聲聞ゆえ",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "140",
   "text": "底なくてたまらぬ影ハさもあらバあれ心の水お月いもそけり",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "141",
   "text": "色もなきかさちグ原のかゞみ草わおみの影比うつるえけり",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "142",
   "text": "桂のみありと思ひしひさかさの月のうちおも松かぜぞふく",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "143",
   "text": "葛城やくめ路ふたえしいは橋のふもかげうかぶ峯のゆふ虹",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "144",
   "text": "朝日影比ほるを見れがわさつみ比限や天のいは戶なるらむ",
   "kana": "",
   "speaker": "",
   "page": 216,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "145",
   "text": "つみはやも昨日の春の木のめおもにほひましさる霜の初花",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "146",
   "text": "總角い牛のあゆみおまかせつゝくれゆく道も急がざりけり",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "147",
   "text": "たかの山さかき御影も匂ふらむ槇の葉おしのありありの月",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "148",
   "text": "くをていにし秋や形見ふとヾめ々む紅葉おさね比衣手比杜",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "149",
   "text": "言の葉比さきはふみ代ふ逢ふけり花のみならぞ實さへ結びて",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "150",
   "text": "ふる里へ通ふ夢路比關守いふきたつ夜半のあらしなりけり",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "151",
   "text": "君いさぞ都の花を成しむらむ我いあしぢの雪をこそおもへ",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "152",
   "text": "あふぎても誰きかざらむ杜宇をちかへりなく千代のふる聲",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "153",
   "text": "をしむらむ世の人並比春ならで今日〓淚ふくれおけるかな",
   "kana": "",
   "speaker": "",
   "page": 217,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  }
 ],
